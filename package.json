{
  "name": "ludo",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:convex": "convex dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "npm run test:logic",
    "test:logic": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:convex": "vitest run --project convex",
    "test:concurrency": "vitest run --project convex tests/convex/concurrency",
    "test:ui": "vitest run --project ui",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit && tsc --noEmit -p convex",
    "test:integration": "npx tsx scripts/test-integration.ts",
    "test:full-game": "npx tsx scripts/test-full-game.ts",
    "load:results-dir": "node -e \"require('fs').mkdirSync('load/results',{recursive:true})\"",
    "load:gameplay": "npm run load:results-dir && k6 run load/k6/gameplay.js",
    "load:reconnect": "npm run load:results-dir && k6 run load/k6/reconnect.js",
    "load:verify": "node load/verify-replay.mjs",
    "prepare:board": "node scripts/prepare-board-art.mjs --debug-grid"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.1",
    "@vercel/analytics": "^2.0.1",
    "convex": "^1.31.0",
    "next": "16.3.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@edge-runtime/vm": "^5.0.0",
    "@playwright/test": "^1.64.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.186.0",
    "@vitest/coverage-v8": "^3.2.7",
    "convex-test": "^0.0.60",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "jsdom": "^30.1.1",
    "sharp": "^0.35.5",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^3.2.7"
  }
}
