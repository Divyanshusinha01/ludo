# Convex
NEXT_PUBLIC_CONVEX_URL=
# Set automatically by `npx convex dev` / `npx convex deploy`

# Debug pages in production builds (always on in development)
# NEXT_PUBLIC_ENABLE_REPLAY_DEBUG=1
# NEXT_PUBLIC_ENABLE_OPS_DASHBOARD=1

# OPS_DASHBOARD_TOKEN is a Convex environment variable, not a Next.js one:
#   npx convex env set OPS_DASHBOARD_TOKEN <value>

# Accounts. Generate all values with: node scripts/generate-auth-keys.mjs
# AUTH_JWT_PRIVATE_KEY='{"kty":"RSA",...}'
# AUTH_SERVER_SECRET=
# Convex side (npx convex env set ...): AUTH_JWKS and the same AUTH_SERVER_SECRET.
# Convex will not push convex/auth.config.ts until AUTH_JWKS is set.

# k6 load tests read their settings from `k6 run -e NAME=value`
# (CONVEX_URL, ROOMS, DURATION, ...). See docs/operations.md.
